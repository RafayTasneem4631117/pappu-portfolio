# Copy this file to ".env" (same folder). Only PUBLIC values go here —
# anything starting with VITE_ is visible to every visitor of the website.
# NEVER put API keys or passwords in this file.

# Leave empty in development (Vite proxies /api to the backend).
# In production set it to your deployed backend, e.g. https://api.example.com
VITE_API_URL=
