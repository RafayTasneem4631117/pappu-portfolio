# Copy this file to ".env" (same folder) and fill in your values.
# The real ".env" is ignored by git — NEVER commit it or share it.

# ---------- General ----------
# Websites allowed to call this API (comma separated). Add your real domain when you deploy.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Chatbot LLM ----------
# Get a key from https://console.anthropic.com  (leave empty to run in "retrieval-only" mode)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=450

# ---------- RAG ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KNOWLEDGE_DIR=knowledge
CHROMA_DIR=chroma_db
TOP_K=4
# Cosine distance limit: smaller = stricter. Chunks further away than this are ignored.
MAX_DISTANCE=0.75

# ---------- Contact form (SMTP email) ----------
# Gmail example: enable 2-Step Verification, then create an "App password"
#   https://myaccount.google.com/apppasswords   (use that 16-character password below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Where contact messages are delivered (your inbox)
CONTACT_TO_EMAIL=

# ---------- Spam protection ----------
CHAT_RATE_LIMIT=20          # chat messages per minute per visitor
CONTACT_RATE_LIMIT=5        # contact messages per hour per visitor
MIN_FORM_FILL_SECONDS=3     # forms submitted faster than this are treated as bots
# Set to true ONLY if the API runs behind a trusted proxy (Nginx, Render, Railway…)
TRUST_PROXY=false
